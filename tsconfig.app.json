{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/test/report-suggestions-api.test.ts", "src/test/report-suggestions-dependencies.test.ts", "src/test/local-api.test.ts", "src/test/report-suggestion-quota.test.ts", "src/test/developer-tester-questions-api.test.ts", "src/test/developer-tester-questions-dependencies.test.ts", "src/test/developer-question-quota.test.ts", "src/test/developer-tester-questions-policy.test.ts"]
}
