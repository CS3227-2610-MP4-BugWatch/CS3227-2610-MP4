    "workflow/explore-handoff-improvements/study/baseline-snapshots/**",
    "workflow/explore-handoff-improvements/study/candidate-snapshots/**"
  ],
  "pagesExclude": [
    "node_modules/*",
    "workflow/submitted-report-editing/runtime.local/**",
    "workflow/mp4-presentation/.capture-runtime/**",
    "node_modules/**",
    "workflow/explanation-skill-evaluation/raw/**",
