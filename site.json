{
  "baseUrl": "",
  "titlePrefix": "",
  "titleSuffix": "BugWatch",
  "faviconPath": "images/SeEduLogo.png",
  "style": {
    "codeTheme": "light"
  },
  "ignore": [
    "workflow/submitted-report-editing/runtime.local/**",
    "workflow/mp4-presentation/.capture-runtime/**",
    "_markbind/layouts/*",
