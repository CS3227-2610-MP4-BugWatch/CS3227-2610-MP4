{
  "name": "bugwatch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docs:build": "markbind build",
    "docs:serve": "markbind serve",
    "test": "vitest",
    "test:coverage": "vitest run --coverage.enabled",
    "test:auth-db": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-auth-db-tests.ps1",
    "test:project-db": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-project-db-tests.ps1",
    "test:report-db": "powershell -NoProfile -ExecutionPolicy Bypass -File ./run-project-db-tests.ps1 -Suite report"
  },
  "dependencies": {
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "markbind-cli": "7.1.1",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
